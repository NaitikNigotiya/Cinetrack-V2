rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'nigotiyanaitik@gmail.com';
    }

    function isValidRating(rating) {
      return rating == null || (rating is number && rating >= 0.5 && rating <= 10.0);
    }

    function isValidTitleKey(key) {
      return key.matches('^(movie|tv):[0-9]+$');
    }

    function isValidStatus(status) {
      return status in ['plan_to_watch', 'watching', 'completed', 'on_hold', 'dropped'];
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }

    // User Data Hierarchy - strictly isolated to verified single owner
    match /users/{userId} {
      allow read, write: if isOwner() && request.auth.uid == userId;

      // Library collection
      match /library/{titleKey} {
        allow read: if isOwner() && request.auth.uid == userId;
        allow create, update: if isOwner() && request.auth.uid == userId
          && isValidTitleKey(titleKey)
          && isValidStatus(request.resource.data.status)
          && isValidRating(request.resource.data.rating)
          && (!('tags' in request.resource.data) || request.resource.data.tags.size() <= 20);
        allow delete: if isOwner() && request.auth.uid == userId;

        // TV Seasons subcollection
        match /seasons/{seasonNumber} {
          allow read, write: if isOwner() && request.auth.uid == userId;
        }
      }

      // Watch History
      match /history/{eventId} {
        allow read, write: if isOwner() && request.auth.uid == userId;
      }

      // Reviews
      match /reviews/{titleKey} {
        allow read: if isOwner() && request.auth.uid == userId;
        allow create, update: if isOwner() && request.auth.uid == userId
          && isValidTitleKey(titleKey)
          && isValidRating(request.resource.data.rating)
          && request.resource.data.body.size() <= 5000;
        allow delete: if isOwner() && request.auth.uid == userId;
      }

      // Notes
      match /notes/{noteId} {
        allow read: if isOwner() && request.auth.uid == userId;
        allow create, update: if isOwner() && request.auth.uid == userId
          && request.resource.data.body.size() <= 5000;
        allow delete: if isOwner() && request.auth.uid == userId;
      }

      // Collections (custom lists)
      match /collections/{collectionId} {
        allow read: if isOwner() && request.auth.uid == userId;
        allow create, update: if isOwner() && request.auth.uid == userId
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && (!('items' in request.resource.data) || request.resource.data.items.size() <= 500);
        allow delete: if isOwner() && request.auth.uid == userId;
      }

      // Planned Watches (Calendar)
      match /plannedWatches/{id} {
        allow read, write: if isOwner() && request.auth.uid == userId;
      }

      // Settings (Preferences)
      match /settings/{settingDoc} {
        allow read, write: if isOwner() && request.auth.uid == userId;
      }

      // Pre-aggregated Stats
      match /stats/{statDoc} {
        allow read: if isOwner() && request.auth.uid == userId;
        allow create, update: if isOwner() && request.auth.uid == userId;
        allow delete: if isOwner() && request.auth.uid == userId;
      }
    }
  }
}
