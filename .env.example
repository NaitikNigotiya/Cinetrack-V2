# ==============================================================================
# CineTrack v2 Environment Configuration
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Client (VITE_ prefix is exposed to the browser)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_USE_EMULATORS="false"

# Server-only (Used in /api serverless functions, NEVER prefix with VITE_)
TMDB_READ_TOKEN=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_PROJECT_ID=""
