{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "src/shared/schemas/**/*.ts",
    "src/features/**/api/*.ts",
    "src/services/**/*.ts",
    "api/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "api/**/*.ts"],
  "ignoreDependencies": [
    "date-fns",
    "framer-motion",
    "@testing-library/react",
    "@testing-library/user-event"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off"
  }
}
